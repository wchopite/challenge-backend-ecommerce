NODE_ENV=development
PORT=3000

# PostgreSQL (default — run `docker compose up -d` first)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ecommerce_challenge

# Local development only (auto-sync schema). Use migrations elsewhere.
DB_SYNCHRONIZE=true

# Docker Compose ports on the host
DB_PORT_HOST=5432
ADMINER_PORT=8080
